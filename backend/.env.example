# ─────────────────────────────────────────────────────────────
# BUBBLO backend environment
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# There is NO OTP / SMS / Firebase / Twilio / MSG91 configuration here —
# COD orders are confirmed manually by phone. Do not add OTP provider keys.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS allow-list)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite database file (relative to the backend/ directory)
DATABASE_FILE=./data/bubblo.sqlite

# Admin auth — generate strong secrets, e.g. `openssl rand -hex 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Bootstrap admin account (used only by `npm run create-admin`)
ADMIN_EMAIL=admin@bubblo.example
ADMIN_PASSWORD=replace-with-a-strong-password

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
ORDER_RATE_LIMIT_MAX=20

# Storefront base URL (used for canonical links / sitemap)
SITE_URL=http://localhost:5173

# ── Owner email notifications (COD orders) ─────────────────────────
# When a customer places a COD order, BUBBLO emails the store owner in the
# BACKGROUND. This NEVER blocks or fails the order: if sending fails, the
# order is still created and the failure is logged server-side only.
#
# The store owner address that receives new-order alerts.
OWNER_EMAIL=mrvickybusines@gmail.com
#
# Which provider to use: smtp | resend | sendgrid | console
#   console  = safe default. Logs the email server-side; needs NO credentials.
#              Use it for local dev / when no provider is configured.
#   smtp     = any SMTP server via nodemailer (see SMTP_* below).
#   resend   = Resend HTTP API (needs EMAIL_PROVIDER_API_KEY).
#   sendgrid = SendGrid v3 API (needs EMAIL_PROVIDER_API_KEY).
EMAIL_PROVIDER=console
#
# API key for the selected HTTP provider (resend / sendgrid). Leave empty for
# smtp / console. NEVER commit a real key — keep it in `.env` only.
EMAIL_PROVIDER_API_KEY=
#
# "From" address shown on the alert. Format: "Name <address>".
EMAIL_FROM=BUBBLO Orders <no-reply@bubblo.store>
#
# SMTP settings — only used when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to true for implicit TLS (usually port 465).
SMTP_SECURE=false

# ── Cloudinary (images only — no secrets needed for public delivery URLs) ──
# The asset manifest lives in code at src/config/cloudinary.js.
# Only set these if you later use signed uploads from the admin panel.
CLOUDINARY_CLOUD_NAME=acqrwkcn
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
