# BUBBLO frontend environment
# Copy to `.env` for local development. Only VITE_* vars reach the browser.

# Base URL of the BUBBLO API.
# Leave empty to use the Vite dev proxy (recommended for local dev).
VITE_API_URL=

# Backend target for the dev proxy.
VITE_API_PROXY=http://localhost:4000

# Public site URL (used for canonical/OG tags and the sitemap).
VITE_SITE_URL=http://localhost:5173

# Cloudinary cloud account used by the asset manifest.
VITE_CLOUDINARY_CLOUD=acqrwkcn
